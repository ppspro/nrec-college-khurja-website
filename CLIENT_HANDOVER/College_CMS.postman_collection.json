{
  "info": {
    "_postman_id": "nrec-cms-v1-2026",
    "name": "NREC College CMS API v1.0",
    "description": "Complete API collection for NREC College Content Management System. Import the environment file first, then run 'Admin Login' to auto-set the Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health",
            "description": "Check if the backend API is running."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if(json.token) { pm.environment.set('token', json.token); pm.environment.set('admin_id', json.admin.id); }",
                  "pm.test('Login successful', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nreccollege.ac.in\",\n  \"password\": \"admin@123\"\n}"
            },
            "description": "Login with admin credentials. The JWT token is automatically saved to the environment variable {{token}}."
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/profile",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"NREC Admin Updated\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"admin@123\",\n  \"newPassword\": \"newSecurePassword\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"admin@nreccollege.ac.in\" }"
            }
          }
        }
      ]
    },
    {
      "name": "News",
      "item": [
        {
          "name": "List All News",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/news?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "news"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "active", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single News",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/news/{{news_id}}"
          }
        },
        {
          "name": "Create News",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/news",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Annual Sports Meet 2026", "type": "text" },
                { "key": "content", "value": "Registration is now open for the Annual Sports Meet 2026.", "type": "text" },
                { "key": "category", "value": "Sports", "type": "text" },
                { "key": "status", "value": "active", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Update News",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/news/{{news_id}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Updated Title\", \"status\": \"active\" }"
            }
          }
        },
        {
          "name": "Delete News",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/news/{{news_id}}"
          }
        }
      ]
    },
